# ---- Database ----
# psycopg v3 driver. Matches the role/database created in the README bootstrap step.
DATABASE_URL=postgresql+psycopg://pajaksim:pajaksim_dev@localhost:5432/pajaksim

# ---- JWT / Auth ----
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# ---- Behaviour ----
# When true, the backend auto-seeds the database on startup if it is empty.
AUTO_SEED=true
